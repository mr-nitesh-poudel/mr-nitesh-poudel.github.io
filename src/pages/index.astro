---
import ThemeToggle from "../components/ThemeToggle.astro";
import logoDark from "../assets/logo-dark.svg?url";
import logoLight from "../assets/logo-light.svg?url";

const navigation = [
  { label: "About", href: "#about" },
  { label: "Work", href: "#work" },
  { label: "Contact", href: "#contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nitesh Poudel, software engineer." />
    <title>Nitesh Poudel | Software Engineer</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme === "light" || savedTheme === "dark") {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Nitesh Poudel home">
          <span class="brand-logo">
            <img class="brand-logo__light" src={logoLight} alt="" />
            <img class="brand-logo__dark" src={logoDark} alt="" />
          </span>
        </a>

        <ul>
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><ThemeToggle /></li>
        </ul>
      </nav>
    </header>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--background);
    color-scheme: light dark;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .site-header {
    width: 100%;
  }

  :global(:root) {
    --background: #ffffff;
    --surface: #f5f5f5;
    --text: #171717;
    --text-muted: #777777;
    --border: #e5e5e5;
    --accent: #d95d39;
  }

  :global(html[data-theme="dark"]) {
    --background: #171717;
    --surface: #242424;
    --text: #f5f5f5;
    --text-muted: #a3a3a3;
    --border: #383838;
    --accent: #ff8b6b;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) {
      --background: #171717;
      --surface: #242424;
      --text: #f5f5f5;
      --text-muted: #a3a3a3;
      --border: #383838;
      --accent: #ff8b6b;
    }
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 3rem, 1200px);
    min-height: 80px;
    margin: 0 auto;
  }

  .brand {
    display: block;
    width: 54px;
    height: 25px;
    text-decoration: none;
  }

  .brand-logo {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .brand-logo img {
    position: absolute;
    top: -39px;
    left: -33px;
    display: block;
    width: 108px;
    max-width: none;
  }

  .brand-logo__dark {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .brand-logo__light {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .brand-logo__dark {
    display: block !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .brand-logo__light {
      display: none !important;
    }

    :global(html:not([data-theme])) .brand-logo__dark {
      display: block !important;
    }
  }

  ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 450;
    letter-spacing: 0;
    text-decoration: none;
    transition: color 160ms ease;
  }

  li a:hover,
  li a:focus-visible {
    color: var(--text);
  }

  a:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  @media (max-width: 560px) {
    nav {
      width: min(100% - 2rem, 1200px);
      min-height: 72px;
    }

    ul {
      gap: 1rem;
    }

    li a {
      font-size: 0.78rem;
    }
  }
</style>
