---
import ThemeToggle from "../components/ThemeToggle.astro";

const projects = [
  { title: "Stacks", kind: "Social platform for iOS", description: "A media-first social product with a native SwiftUI experience and backend systems designed to keep uploads dependable.", stack: ["SwiftUI", "Laravel", "AWS S3", "MySQL"] },
  { title: "APIClient", kind: "Swift networking library", description: "A type-safe HTTP layer that keeps requests, responses, and multipart uploads easy to reason about across a growing iOS codebase.", stack: ["Swift", "Combine", "REST", "Protocols"] },
  { title: "ProcessQueue", kind: "Media processing pipeline", description: "A background processing system for validating uploads, converting image formats, and delivering ready-to-use media to S3.", stack: ["Laravel", "Queues", "AWS", "Redis"] },
];
const skills = ["Swift", "SwiftUI", "Laravel", "PHP", "TypeScript", "AWS", "MySQL", "Redis"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Nitesh Poudel, a software engineer building mobile products and dependable backends." />
    <title>Nitesh Poudel — Software Engineer</title>
    <script is:inline>const savedTheme = localStorage.getItem("theme"); if (savedTheme === "light" || savedTheme === "dark") document.documentElement.dataset.theme = savedTheme;</script>
  </head>
  <body>
    <div class="page-shell">
      <header class="intro" id="top">
        <div>
          <a class="name" href="#top">Nitesh Poudel</a>
          <p class="role">Software Engineer</p>
          <p class="summary">I build thoughtful mobile products, dependable backends, and the infrastructure that connects them.</p>
          <nav aria-label="Primary navigation">
            <span class="nav-label">Site index</span>
            <div class="nav-grid">
              <a href="#about">About</a>
              <a href="#work">Work</a>
              <a href="#contact">Contact</a>
            </div>
          </nav>
        </div>
        <div class="intro-footer">
          <div class="socials" aria-label="Social links">
            <a href="https://github.com/mr-nitesh-poudel" target="_blank" rel="noopener" aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.15-4.56-5.09 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0112 6.81c.85 0 1.69.12 2.49.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.95-2.34 4.82-4.57 5.08.36.32.68.93.68 1.87 0 1.35-.01 2.43-.01 2.76 0 .27.18.6.69.49A10.24 10.24 0 0022 12.23C22 6.58 17.52 2 12 2Z" /></svg>
            </a>
            <a href="https://wa.me/" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.52 3.48A11.8 11.8 0 0012.1 0C5.62 0 .35 5.27.35 11.75c0 2.07.54 4.1 1.57 5.89L.25 23.74l6.25-1.64a11.7 11.7 0 005.6 1.43h.01c6.48 0 11.75-5.27 11.75-11.75 0-3.14-1.22-6.1-3.34-8.3Zm-8.42 18.06a9.72 9.72 0 01-4.96-1.36l-.36-.21-3.71.98.99-3.61-.24-.37a9.75 9.75 0 01-1.5-5.2c0-5.37 4.37-9.74 9.75-9.74 2.6 0 5.05 1.01 6.89 2.85a9.66 9.66 0 012.85 6.89c0 5.38-4.37 9.75-9.72 9.77Zm5.34-7.3c-.29-.14-1.7-.84-1.97-.93-.26-.1-.45-.14-.64.14-.19.28-.74.93-.91 1.12-.17.19-.33.21-.62.07-1.7-.85-2.82-1.51-3.94-3.42-.3-.51.3-.47.86-1.57.1-.2.05-.37-.02-.52-.07-.14-.64-1.54-.87-2.1-.23-.55-.47-.47-.64-.48h-.55c-.19 0-.5.07-.76.35-.26.28-1 1-.1 2.44.89 1.44 1.62 2.51 3.5 3.51 1.19.63 1.65.68 2.25.58.37-.06 1.13-.46 1.29-.9.16-.45.16-.83.11-.91-.05-.1-.24-.15-.5-.29Z" /></svg>
            </a>
            <a href="mailto:contact@niteshpoudel.com" aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 5.5A2.5 2.5 0 015 3h14a2.5 2.5 0 012.5 2.5v13A2.5 2.5 0 0119 21H5a2.5 2.5 0 01-2.5-2.5v-13Zm2 .56v.27l7.5 5.25 7.5-5.25v-.27A.5.5 0 0019 5H5a.5.5 0 00-.5.56Zm15 2.72-6.93 4.85a1 1 0 01-1.14 0L4.5 8.78v9.72c0 .28.22.5.5.5h14a.5.5 0 00.5-.5V8.78Z" /></svg>
            </a>
          </div>
          <ThemeToggle />
        </div>
      </header>

      <main>
        <section id="about" aria-labelledby="about-title">
          <p class="eyebrow">About</p>
          <h1 id="about-title">Building products that feel simple, even when the systems behind them are not.</h1>
          <p>I’m a full-stack developer who enjoys working where product thinking and engineering meet. My work spans native iOS apps, APIs, background processing, and cloud infrastructure.</p>
          <p>I care about clear interfaces, resilient systems, and shipping useful things that can keep improving after launch.</p>
          <div class="skill-list" aria-label="Tools I use">{skills.map((skill) => <span>{skill}</span>)}</div>
        </section>

        <section id="work" aria-labelledby="work-title">
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title">Projects I’ve enjoyed building.</h2>
          <div class="projects">
            {projects.map((project, index) => (
              <article class="project">
                <span class="number">0{index + 1}</span>
                <div>
                  <p class="project-kind">{project.kind}</p>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <ul aria-label={`${project.title} technologies`}>{project.stack.map((item) => <li>{item}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="contact" aria-labelledby="contact-title">
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">Let’s make something useful.</h2>
          <p>Have a product or technical problem to solve? My inbox is open.</p>
          <div class="email-actions">
            <a class="email" href="mailto:contact@niteshpoudel.com">contact@niteshpoudel.com <span>↗</span></a>
            <button class="copy-email" type="button" data-email="contact@niteshpoudel.com" aria-label="Copy email address">Copy</button>
          </div>
        </section>
        <footer>© {new Date().getFullYear()} Nitesh Poudel · Built with Astro</footer>
      </main>
    </div>
  </body>
</html>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>(".copy-email");

  copyButton?.addEventListener("click", async () => {
    const email = copyButton.dataset.email;
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      copyButton.textContent = "Copied!";
      copyButton.setAttribute("aria-label", "Email address copied");
      window.setTimeout(() => {
        copyButton.textContent = "Copy";
        copyButton.setAttribute("aria-label", "Copy email address");
      }, 1800);
    } catch {
      copyButton.textContent = "Try again";
      window.setTimeout(() => (copyButton.textContent = "Copy"), 1800);
    }
  });
</script>

<style>
  :global(:root) { --bg:#171717; --surface:#20201f; --text:#f7f6f2; --muted:#aaa9a3; --border:#3a3a37; --accent:#f06b61; }
  :global(html[data-theme="light"]) { --bg:#ffffff; --surface:#f5f5f3; --text:#191919; --muted:#6d6d69; --border:#deded9; --accent:#d64238; }
  @media (prefers-color-scheme: light) { :global(html:not([data-theme])) { --bg:#ffffff; --surface:#f5f5f3; --text:#191919; --muted:#6d6d69; --border:#deded9; --accent:#d64238; } }
  :global(*) { box-sizing:border-box; } :global(html) { scroll-behavior:smooth; background:var(--bg); } :global(body) { margin:0; background:var(--bg); color:var(--text); font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; } :global(a) { color:inherit; }
  .page-shell { width:min(100% - 3rem, 1160px); min-height:100vh; margin:auto; display:grid; grid-template-columns:42% 58%; gap:4rem; }
  .intro { position:sticky; top:0; height:100vh; display:flex; flex-direction:column; justify-content:space-between; padding:5.8rem 0 3.5rem; } .name { font-size:clamp(2rem, 3vw, 2.9rem); font-weight:750; letter-spacing:-.065em; text-decoration:none; } .role { margin: .5rem 0 1.2rem; font-size:1.15rem; font-weight:600; letter-spacing:-.025em; } .summary { max-width:330px; margin:0; color:var(--muted); font-size:.95rem; line-height:1.65; }
  nav { width:min(100%, 300px); margin-top:4.8rem; } .nav-label { display:block; margin-bottom:.7rem; color:var(--muted); font-size:.63rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; } .nav-grid { display:grid; grid-template-columns:1fr 1fr; gap:.45rem; } nav a { padding:.7rem .8rem; border:1px solid var(--border); border-radius:3px; color:var(--muted); font-size:.74rem; font-weight:650; text-decoration:none; transition:background .18s, border-color .18s, color .18s; } nav a:first-child { grid-column:1 / -1; } nav a:hover { border-color:var(--accent); background:var(--surface); color:var(--text); } nav a::after { content:"↘"; float:right; color:var(--accent); opacity:0; transition:opacity .18s; } nav a:hover::after { opacity:1; }
  .intro-footer { display:flex; align-items:center; gap:.8rem; } .socials { display:flex; align-items:center; gap:.45rem; } .socials a { display:grid; width:2rem; height:2rem; place-items:center; border:1px solid var(--border); border-radius:50%; color:var(--muted); transition:border-color .18s, color .18s, transform .18s; } .socials a:hover { border-color:var(--accent); color:var(--accent); transform:translateY(-2px); } .socials svg { width:1rem; height:1rem; fill:currentColor; } .email span { color:var(--accent); } :global(.theme-toggle) { margin-left:.2rem; }
  main { padding:5.8rem 0 0; } section { margin-bottom:9rem; scroll-margin-top:2rem; } .eyebrow { margin:0 0 1.75rem; color:var(--accent); font-size:.7rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; } h1, h2, h3, p { margin-top:0; } h1, h2 { max-width:640px; font-size:clamp(1.7rem, 3.1vw, 2.45rem); font-weight:650; letter-spacing:-.045em; line-height:1.15; } h1 ~ p { max-width:590px; color:var(--muted); font-size:.96rem; line-height:1.75; } .skill-list { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:1.7rem; } .skill-list span, li { padding:.25rem .45rem; border:1px solid var(--border); color:var(--muted); font-size:.67rem; }
  .projects { display:grid; gap:.35rem; margin-top:2.8rem; } .project { display:grid; grid-template-columns:48px 1fr; gap:1.1rem; padding:1.4rem; border-radius:5px; transition:background .18s; } .project:hover { background:var(--surface); } .number, .project-kind { color:var(--muted); font-size:.68rem; font-weight:650; letter-spacing:.07em; text-transform:uppercase; } .project-kind { margin-bottom:.45rem; } h3 { margin-bottom:.65rem; font-size:1.15rem; letter-spacing:-.03em; } .project div > p:not(.project-kind) { max-width:520px; margin-bottom:1rem; color:var(--muted); font-size:.87rem; line-height:1.65; } ul { display:flex; flex-wrap:wrap; gap:.4rem; padding:0; margin:0; list-style:none; }
  #contact h2 { font-size:clamp(2.2rem, 4.3vw, 3.6rem); } #contact > p:not(.eyebrow) { color:var(--muted); line-height:1.7; } .email-actions { display:flex; align-items:center; flex-wrap:wrap; gap:.8rem; margin-top:1rem; } .email { display:inline-block; border-bottom:1px solid var(--accent); color:var(--text); font-weight:650; text-decoration:none; padding-bottom:.2rem; } .copy-email { padding:.38rem .62rem; border:1px solid var(--border); border-radius:3px; background:transparent; color:var(--muted); font:inherit; font-size:.7rem; font-weight:650; cursor:pointer; transition:border-color .18s, color .18s; } .copy-email:hover, .copy-email:focus-visible { border-color:var(--accent); color:var(--accent); outline:none; } footer { padding:2rem 0; border-top:1px solid var(--border); color:var(--muted); font-size:.7rem; }
  @media (max-width:800px) { .page-shell { display:block; width:min(100% - 2.4rem, 680px); } .intro { position:relative; height:auto; padding:4.5rem 0 3.5rem; } nav { display:none; } .intro-footer { margin-top:2rem; } main { padding:2.5rem 0 0; } section { margin-bottom:6rem; } }
</style>
