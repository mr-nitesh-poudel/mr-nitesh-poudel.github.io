<button class="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="false">
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.8 15.6A9 9 0 0 1 8.4 3.2a9 9 0 1 0 12.4 12.4Z" />
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
  const storedTheme = localStorage.getItem("theme");

  const resolvedTheme = () =>
    document.documentElement.dataset.theme === "dark" ||
    (!document.documentElement.dataset.theme && mediaQuery.matches)
      ? "dark"
      : "light";

  const updateToggle = () => {
    const isDark = resolvedTheme() === "dark";
    toggle?.setAttribute("aria-pressed", String(isDark));
    toggle?.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} theme`);
  };

  if (storedTheme === "light" || storedTheme === "dark") {
    document.documentElement.dataset.theme = storedTheme;
  }

  updateToggle();

  toggle?.addEventListener("click", () => {
    const nextTheme = resolvedTheme() === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("theme", nextTheme);
    updateToggle();
  });

  mediaQuery.addEventListener("change", updateToggle);
</script>

<style>
  .theme-toggle {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .theme-toggle:hover {
    background: var(--surface);
    border-color: var(--text-muted);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .theme-toggle__icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .theme-toggle__icon--sun {
    color: var(--accent);
  }

  .theme-toggle__icon--sun circle {
    fill: currentColor;
  }

  .theme-toggle__icon--moon {
    display: none;
    color: #252525;
  }

  .theme-toggle__icon--moon path {
    fill: currentColor;
  }

  :global(html[data-theme="dark"]) .theme-toggle {
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #252525;
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .theme-toggle {
      background: #f5f5f5;
      border-color: #f5f5f5;
      color: #252525;
    }

    :global(html:not([data-theme])) .theme-toggle__icon--sun {
      display: none;
    }

    :global(html:not([data-theme])) .theme-toggle__icon--moon {
      display: block;
    }
  }
</style>
